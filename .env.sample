# The GETH_* names below are historical examples. The Generator is chain-agnostic and accepts any compatible JSON-RPC and WebSocket endpoint, not just Geth.
GETH_RPC_URL=YOUR_GETH_RRC
GETH_WS_URL=YOUR_WEB_SOCKET
GETH_API_KEY=YOUR_API_KEY
# The chain the RPC serves. Change all three together.
# CHAIN_NAME=Ethereum
# CHAIN_NETWORK=Mainnet
# CHAIN_ID=1
# Tokens mode indexes block headers and the listed contracts' logs only.
# CHAIN_MODE=tokens
# CHAIN_CONTRACTS=0x...,0x...
INDEXER_START_HEIGHT=BLOCK_START_HEIGHT
DEFRADB_KEYRING_SECRET=YOUR_DEFRADB_KEYRING_SECRET # make sure is the same if you are not starting fresh.
GETH_API_KEY_TYPE=x-api-key | x-goog-api-key
SCHEMA_AUTH_MODE=none | token | mtls
SCHEMA_API_KEYS=YOUR_API_KEY1, YOUR_API_KEY2, YOUR_API_KEY3, ...
