# The GETH_* names below are historical examples. The Generator is chain-agnostic and accepts any compatible JSON-RPC and WebSocket endpoint, not just Geth.
GETH_RPC_URL=YOUR_GETH_RRC
GETH_WS_URL=YOUR_WEB_SOCKET
GETH_API_KEY=YOUR_API_KEY
# The chain the RPC serves. Change all three together.
# CHAIN_NAME=Ethereum
# CHAIN_NETWORK=Mainnet
# CHAIN_ID=1
# Tokens mode writes, per block, the raw header, each token's Evidence (its transactions and receipts,
# with their proof), the tokens' total supplies every CHAIN_STATE_CAPTURE_INTERVAL blocks (a token
# whose proof fails every attempt is skipped at that block), and the signed statement. Each token is
# address:supply_slot, the supply slot being the storage slot of its total supply in 0x-prefixed hex.
# CHAIN_FINALIZED_POLL_INTERVAL_MS is the milliseconds between finalized-height polls once dispatch
# has reached that height; unset or 0 means 1000. Tokens mode refuses to start with
# DEFRADB_P2P_ACCEPT_INCOMING=true, and without SNAPSHOT_ENABLED=false (the shipped config.yaml
# enables snapshots), an INDEXER_START_HEIGHT above 0, and PRUNER_MAX_BLOCKS of at least twice
# INDEXER_CONCURRENT_BLOCKS. Lowering INDEXER_CONCURRENT_BLOCKS and PRUNER_MAX_BLOCKS across a restart
# can resume past a height that was never stored, because resume assumes PRUNER_MAX_BLOCKS covers the
# previous run's dispatch window. Lowering INDEXER_START_HEIGHT below an existing store does not
# backfill the heights PRUNER_MAX_BLOCKS or more below the highest stored height.
# CHAIN_MODE=tokens
# CHAIN_TOKENS=0x...:0x...,0x...:0x...
# CHAIN_STATE_CAPTURE_INTERVAL=...
# CHAIN_FINALIZED_POLL_INTERVAL_MS=...
INDEXER_START_HEIGHT=BLOCK_START_HEIGHT
DEFRADB_KEYRING_SECRET=YOUR_DEFRADB_KEYRING_SECRET # make sure is the same if you are not starting fresh.
GETH_API_KEY_TYPE=x-api-key | x-goog-api-key
SCHEMA_AUTH_MODE=none | token | mtls
SCHEMA_API_KEYS=YOUR_API_KEY1, YOUR_API_KEY2, YOUR_API_KEY3, ...

